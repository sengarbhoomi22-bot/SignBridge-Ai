# ==============================================================================
# SignBridge AI Backend Environment Configuration Template
# ==============================================================================

# Project & Debug
PROJECT_NAME="SignBridge AI Backend"
VERSION="0.1.0"
DEBUG=false
API_V1_STR="/api/v1"

# CORS Allowed Origins (Comma-separated or JSON list in environment)
# ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Temporal Video Limits & Preprocessing
MAX_VIDEO_SIZE_MB=25
MIN_VIDEO_DURATION_SEC=1.0
MAX_VIDEO_DURATION_SEC=8.0
TARGET_SAMPLE_FPS=20
MAX_SEQUENCE_LENGTH=160

# Quality Gating & Confidence
CALIBRATED_CONFIDENCE_THRESHOLD=0.50
MIN_LANDMARK_DETECTION_RATIO=0.60
HAND_DETECTION_MODE="any_hand"
TEMPERATURE_SCALING_FACTOR=1.0

# Model Paths & Device
MODEL_WEIGHTS_PATH="models/weights/baseline_isl.pth"
DEVICE="cpu"

